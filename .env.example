# Copy this file to ".env" and fill it in. ".env" is private: it is in .gitignore, never commit it.
# With no .env at all, `npm run server` still works: it uses a small database stored in .data/ on your computer.

# --- Database (Neon) ---------------------------------------------------------
# Neon dashboard > your project > "Connect" > choose the pooled connection and copy the string.
# Leave this out while you are developing locally to use the built-in database instead.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Login security ----------------------------------------------------------
# A long random text that signs login tokens. Required in production (at least 32 characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# --- Server ------------------------------------------------------------------
# PORT=3000
# Extra websites allowed to call the API (comma separated). The Android app is always allowed.
# CORS_ORIGINS=https://www.example.com
# 1 when the server sits behind a proxy such as Render, Railway or Nginx (needed for correct rate limiting)
# TRUST_PROXY=0
# Most database connections kept open at once (Neon's free plan has a limit)
# DB_POOL_MAX=10
# Set to false to stop the server creating tables when it starts (run `npm run db:migrate` yourself instead)
# AUTO_MIGRATE=true
