{
  "name": "scentop",
  "version": "0.0.1",
  "author": "ScenTop team",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web -c magenta,cyan \"npm:api\" \"npm:web\"",
    "dev": "npm start",
    "server": "npm run api",
    "build": "ng build",
    "build:mobile": "ng build --configuration mobile",
    "build:demo": "ng build --configuration demo",
    "build:server": "node scripts/build-server.mjs",
    "build:admin": "ng build admin",
    "build:site": "ng build && ng build admin && node -e \"require('fs').cpSync('www-admin','www/admin',{recursive:true})\"",
    "build:all": "npm run build && npm run build:admin && npm run build:server",
    "start:prod": "node dist-server/index.js",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:all": "npm run test:server && ng test --watch=false",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "db:check": "tsx server/cli.ts check",
    "db:demo": "tsx server/cli.ts demo",
    "db:demo-clear": "tsx server/cli.ts demo-clear",
    "admin:make": "tsx server/cli.ts make-admin",
    "admin:create": "tsx server/cli.ts create-admin",
    "assets:android": "capacitor-assets generate --android",
    "cap:sync": "npm run build:mobile && cap sync android",
    "android": "npm run cap:sync && cap open android",
    "android:apk": "npm run cap:sync && node scripts/build-apk.mjs",
    "android:demo": "npm run build:demo && cap sync android && node scripts/build-apk.mjs --copy-to ScenTop-demo.apk",
    "android:install": "node scripts/install-apk.mjs",
    "demo:data": "tsx scripts/build-demo-data.ts",
    "lint:server": "eslint server",
    "lint:all": "ng lint app && ng lint admin && eslint server",
    "api": "tsx watch server/index.ts",
    "web": "ng serve",
    "admin": "ng serve admin",
    "dev:all": "concurrently -k -n api,web,admin -c magenta,cyan,yellow \"npm:api\" \"npm:web\" \"npm:admin\"",
    "prestart": "node scripts/check-env.mjs"
  },
  "private": true,
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "6.2.13",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "angular-eslint": "22.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "ionicons": "^8.1.0",
    "jsdom": "^26.0.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  },
  "description": "ScenTop - an online perfume shop (Ionic + Angular app, Express API, Neon Postgres)",
  "engines": {
    "node": ">=22.12.0"
  }
}
